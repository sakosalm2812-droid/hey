VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_HEY_API_URL=https://your-project.supabase.co/functions/v1/hey

# Set these as Supabase Edge Function secrets, not Vite variables.
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
APP_URL=http://localhost:5173

# Optional Studio endpoint; otherwise derived from VITE_SUPABASE_URL.
# VITE_HEY_STUDIO_URL=https://your-project.supabase.co/functions/v1/hey-studio
